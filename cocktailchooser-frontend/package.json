{
  "name": "cocktailchooser-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "node --no-deprecation ./node_modules/@vue/cli-service/bin/vue-cli-service.js serve",
    "serve:debug": "node --no-deprecation ./node_modules/@vue/cli-service/bin/vue-cli-service.js serve",
    "build": "node --no-deprecation ./node_modules/@vue/cli-service/bin/vue-cli-service.js build",
    "lint": "node --no-deprecation ./node_modules/@vue/cli-service/bin/vue-cli-service.js lint",
    "cap:sync": "npx cap sync",
    "cap:sync:build": "npm run build && npx cap sync",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@babel/preset-env": "^7.24.7",
    "@capacitor/android": "^7.6.1",
    "@capacitor/core": "^7.6.1",
    "@capacitor/ios": "^7.6.1",
    "axios": "^1.7.2",
    "core-js": "^3.8.3",
    "driver.js": "^1.4.0",
    "vue": "^3.2.13",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/eslint-parser": "^7.12.16",
    "@capacitor/cli": "^7.6.1",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
